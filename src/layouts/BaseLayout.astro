---
interface Props {
  title?: string;
  description?: string;
  faviconUrl?: string;
  shareTitle?: string;
  shareDescription?: string;
  shareImageUrl?: string;
  canonicalUrl?: string;
  themeColor?: string;
}

const {
  title = "Fine Services — Photography",
  description = "Fine Services — arquivo fotográfico de Felipe Barbosa.",
  faviconUrl = "/favicon.svg",
  shareTitle = title,
  shareDescription = description,
  shareImageUrl,
  canonicalUrl,
  themeColor,
} = Astro.props;
const canonical = canonicalUrl
  ? new URL(Astro.url.pathname, canonicalUrl).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/WTGaramonoTRIAL-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/WTGaramonoTRIAL-Italic.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/KMRMelangeGrotesk-Regular.woff" as="font" type="font/woff" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconUrl} />
    {themeColor ? <meta name="theme-color" content={themeColor} /> : null}
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {shareImageUrl ? <meta property="og:image" content={shareImageUrl} /> : null}
    <meta name="twitter:card" content={shareImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    {shareImageUrl ? <meta name="twitter:image" content={shareImageUrl} /> : null}
    <title>{title}</title>
    <script is:inline>
      (() => {
        const revealPage = () => document.documentElement.classList.add("fonts-ready");

        const loadPortfolioFonts = async () => {
          if (!document.fonts) {
            revealPage();
            return;
          }

          try {
            await Promise.all([
              document.fonts.load('400 18px "WT Garamono"'),
              document.fonts.load('italic 400 11px "WT Garamono"'),
              document.fonts.load('400 10px "KMR Melange Grotesk"'),
            ]);
          } finally {
            revealPage();
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", loadPortfolioFonts, { once: true });
        } else {
          loadPortfolioFonts();
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
