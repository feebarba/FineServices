---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import ProjectMeta from "../components/ProjectMeta.astro";
import { getFallbackProjects, fallbackHome } from "../data/fallback";
import { getPortfolioHome, getPortfolioProjects, getPortfolioSiteConfig } from "../lib/sanity";
import type {
  PhotoOrientation,
  PortfolioProject as Project,
  ProjectMedia,
} from "../lib/portfolio-types";
import "../styles/global.css";

const cmsHome = await getPortfolioHome();
const cmsProjects = await getPortfolioProjects();
const cmsSiteConfig = await getPortfolioSiteConfig();
const home = cmsHome ?? fallbackHome;
const projects: Project[] = cmsProjects ?? getFallbackProjects();

const designProjects = cmsProjects
  ? projects.filter((project) => project.section === "design")
  : projects.slice(0, -1);
const photographyProjects = cmsProjects
  ? projects.filter((project) => project.section === "photography")
  : projects;
const designMediaByProject: ProjectMedia[][] = designProjects.map(
  (project) => project.designMedia ?? project.photos ?? [],
);

const orientationsByProject: PhotoOrientation[][] = photographyProjects.map(({ photoCount, photos }) => {
  if (photos) {
    return photos.map(({ orientation }) => orientation);
  }

  return Array.from({ length: photoCount }, (_, photoIndex) =>
    photoIndex % 2 === 0 ? "vertical" : "horizontal",
  );
});

const designOrientationsByProject = designMediaByProject.map((media) =>
  media.map(({ orientation }) => orientation),
);

const totalPhotoCount = photographyProjects.reduce((total, project) => total + project.photoCount, 0);
type PortfolioTab = "home" | "design" | "photography";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const initialTab: PortfolioTab = normalizedPath === "/design"
  ? "design"
  : normalizedPath === "/photography"
    ? "photography"
    : "home";
const siteTitle = cmsSiteConfig?.title ?? "Felipe Barbosa";
const pageDescription = cmsSiteConfig?.description ?? "Portfólio de design e fotografia de Felipe Barbosa.";
const pageTitle = initialTab === "design"
  ? `Design — ${siteTitle}`
  : initialTab === "photography"
    ? `Photography — ${siteTitle}`
    : siteTitle;
---

<BaseLayout
  title="FELIPE BARBOSA"
  description={pageDescription}
  faviconUrl={cmsSiteConfig?.faviconUrl}
  shareTitle={cmsSiteConfig?.shareTitle ?? pageTitle}
  shareDescription={cmsSiteConfig?.shareDescription ?? pageDescription}
  shareImageUrl={cmsSiteConfig?.shareImageUrl}
  canonicalUrl={cmsSiteConfig?.canonicalUrl}
  themeColor={cmsSiteConfig?.themeColor}
>
  <main class="portfolio-shell" id="index">
    <div class="home-return-hit-area" data-home-return-area aria-hidden="true"></div>
    <section class:list={["tab", "home-panel", { active: initialTab === "home" }]} data-home-panel aria-label="Página inicial">
      <div class="tab-head home-head">
        <header class="site-header">
          <a href="/" class="brand" data-home-toggle>
            {home.brandAnimation ? (
              <span
                data-brand-typewriter
                data-primary-brand={home.brand}
                data-secondary-brand="Fine Services"
              >{home.brand}</span>
            ) : (
              home.brand
            )}
          </a>
        </header>
      </div>

      <div class="tab-content home-content" data-home-content>
        <div class="home-inner">
          <div class="home-copy">
            {home.intro.map((paragraph) => <p>{paragraph}</p>)}

            {home.lists.map((list) => (
              <div class="home-list">
                <div class="home-list-label"><p><i>{list.title}</i></p></div>
                <div class="home-list-items">
                  {list.items.map((item) => (
                    <p>{item.title}<br /><i>{item.detail}</i></p>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class:list={["tab", "design-panel", { active: initialTab === "design", inactive: initialTab === "photography" }]} data-design-panel aria-label="Design">
      <a
        class="tab-heading design-toggle"
        href="/design"
        data-design-toggle
        aria-controls="design-content"
        aria-expanded={String(initialTab === "design")}
      >
        <span>Design</span>
        <span>{designProjects.length} projects</span>
      </a>
      <div class="tab-content design-content" id="design-content" data-design-content aria-hidden={String(initialTab !== "design")}>
        <div class="project-list">
          {designProjects.map((project, projectIndex) => (
            <article class="project">
              <ProjectMeta project={project} projectIndex={projectIndex} variant="design" />
              <ProjectGallery
                projectTitle={project.title}
                variant="design"
                media={designMediaByProject[projectIndex]}
                photoCount={designMediaByProject[projectIndex].length}
                orientations={designOrientationsByProject[projectIndex]}
              />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class:list={["tab", "collection", "photography-panel", { active: initialTab === "photography" }]} id="photography-panel" data-photography-panel aria-labelledby="collection-title">
      <a
        class="collection-heading collection-toggle"
        href="/photography"
        data-photography-toggle
        aria-controls="photography-content"
        aria-expanded={String(initialTab === "photography")}
      >
        <h1 id="collection-title">Photography</h1>
        <span>{totalPhotoCount} images</span>
      </a>

      <div class="collection-content" id="photography-content" data-photography-content aria-hidden={String(initialTab !== "photography")}>
        <div class="project-list">
          {photographyProjects.map((project, projectIndex) => (
            <article class="project">
              <ProjectMeta project={project} projectIndex={projectIndex} variant="photography" />
              <ProjectGallery
                projectTitle={project.title}
                variant="photography"
                photos={project.photos}
                photoCount={project.photoCount}
                orientations={orientationsByProject[projectIndex]}
              />
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import "../scripts/portfolio-interactions";
</script>
